{"name":"config","settings":"{\"settings\":\"{\\n    \\\"terminal.integrated.inheritEnv\\\": false,\\n    \\\"jupyter.jupyterCommandLineArguments\\\": [],\\n    \\\"editor.fontSize\\\": 18,\\n    \\\"editor.formatOnSave\\\": true,\\n    \\\"workbench.startupEditor\\\": \\\"newUntitledFile\\\",\\n    \\\"editor.inlayHints.enabled\\\": \\\"on\\\",\\n    \\\"editor.fontFamily\\\": \\\"Monaco Nerd Font\\\",\\n    \\\"editor.suggest.showIcons\\\": true,\\n    \\\"editor.suggest.snippetsPreventQuickSuggestions\\\": false,\\n    \\\"editor.suggest.filterGraceful\\\": true,\\n    \\\"editor.suggest.localityBonus\\\": true,\\n    \\\"editor.suggest.shareSuggestSelections\\\": true,\\n    \\\"git.autofetch\\\": true,\\n    \\\"workbench.iconTheme\\\": \\\"eq-material-theme-icons-darker\\\",\\n    \\\"workbench.colorCustomizations\\\": {\\n        \\\"editorIndentGuide.activeBackground2\\\": \\\"#ff0000\\\",\\n        \\\"editorIndentGuide.activeBackground3\\\": \\\"#a51283\\\",\\n        \\\"editorIndentGuide.activeBackground4\\\": \\\"#ff8c00\\\",\\n        \\\"editorIndentGuide.activeBackground5\\\": \\\"#ffc400\\\",\\n        \\\"editorIndentGuide.activeBackground6\\\": \\\"#ffc400\\\",\\n        // non-active indent guide colors\\n        \\\"editorIndentGuide.background1\\\": \\\"#0066ff\\\",\\n        \\\"editorIndentGuide.background2\\\": \\\"#00e5ff\\\",\\n        \\\"editorIndentGuide.background3\\\": \\\"#00e5ff\\\",\\n        \\\"editorIndentGuide.background4\\\": \\\"#00e5ff\\\",\\n        \\\"editorIndentGuide.background5\\\": \\\"#00e5ff\\\",\\n        \\\"editorIndentGuide.background6\\\": \\\"#00e5ff\\\"\\n    },\\n    \\\"workbench.editorAssociations\\\": {},\\n    \\\"workbench.editor.enablePreview\\\": false,\\n    \\\"EnglishChineseDictionary.enableHover\\\": true,\\n    \\\"editor.smoothScrolling\\\": true,\\n    \\\"editor.cursorSmoothCaretAnimation\\\": \\\"on\\\",\\n    \\\"workbench.list.smoothScrolling\\\": true,\\n    \\\"terminal.integrated.smoothScrolling\\\": true,\\n    \\\"Lua.hint.enable\\\": true,\\n    \\\"go.inlayHints.functionTypeParameters\\\": true,\\n    \\\"go.inlayHints.parameterNames\\\": true,\\n    \\\"go.inlayHints.rangeVariableTypes\\\": true,\\n    \\\"go.inlayHints.compositeLiteralFields\\\": true,\\n    \\\"python.analysis.inlayHints.functionReturnTypes\\\": true,\\n    \\\"python.analysis.inlayHints.pytestParameters\\\": true,\\n    \\\"python.analysis.inlayHints.variableTypes\\\": true,\\n    \\\"javascript.inlayHints.enumMemberValues.enabled\\\": true,\\n    \\\"javascript.inlayHints.functionLikeReturnTypes.enabled\\\": true,\\n    \\\"javascript.inlayHints.parameterNames.enabled\\\": \\\"literals\\\",\\n    \\\"go.inlayHints.compositeLiteralTypes\\\": true,\\n    \\\"go.inlayHints.constantValues\\\": true,\\n    \\\"javascript.inlayHints.parameterTypes.enabled\\\": true,\\n    \\\"javascript.inlayHints.propertyDeclarationTypes.enabled\\\": true,\\n    \\\"javascript.inlayHints.variableTypes.enabled\\\": true,\\n    \\\"typescript.inlayHints.enumMemberValues.enabled\\\": true,\\n    \\\"typescript.inlayHints.functionLikeReturnTypes.enabled\\\": true,\\n    \\\"typescript.inlayHints.parameterTypes.enabled\\\": true,\\n    \\\"typescript.inlayHints.propertyDeclarationTypes.enabled\\\": true,\\n    \\\"typescript.inlayHints.variableTypes.enabled\\\": true,\\n    \\\"emmet.showSuggestionsAsSnippets\\\": true,\\n    \\\"editor.suggestSelection\\\": \\\"first\\\",\\n    \\\"editor.suggestFontSize\\\": 18,\\n    \\\"editor.suggestLineHeight\\\": 20,\\n    \\\"git.confirmSync\\\": false,\\n    \\\"database-client.autoSync\\\": true,\\n    \\\"jupyter.askForKernelRestart\\\": false,\\n    \\\"[dart]\\\": {\\n        \\\"editor.formatOnSave\\\": true,\\n        \\\"editor.formatOnType\\\": true,\\n        \\\"editor.rulers\\\": [\\n            80\\n        ],\\n        \\\"editor.selectionHighlight\\\": false,\\n        \\\"editor.tabCompletion\\\": \\\"onlySnippets\\\",\\n        \\\"editor.wordBasedSuggestions\\\": \\\"off\\\"\\n    },\\n    \\\"markdown-pdf.styles\\\": [\\n        \\\"/Users/xinghe/Documents/gongwen.css\\\"\\n    ],\\n    \\\"indentRainbow.colors\\\": [\\n        \\\"rgba(255,255,64,0.07)\\\",\\n        \\\"rgba(127,255,127,0.07)\\\",\\n        \\\"rgba(255,127,255,0.07)\\\",\\n        \\\"rgba(79,236,236,0.07)\\\"\\n    ],\\n    \\\"diffEditor.hideUnchangedRegions.enabled\\\": true,\\n    \\\"vim.useSystemClipboard\\\": true,\\n    \\\"vim.hlsearch\\\": true,\\n    \\\"vim.leader\\\": \\\"<space>\\\",\\n    \\\"vim.handleKeys\\\": {\\n        \\\"<C-a>\\\": false,\\n        \\\"<C-f>\\\": false,\\n        \\\"<C-v>\\\": false,\\n        \\\"<C-c>\\\": false,\\n        \\\"<Tab>\\\": false,\\n        \\\"<space>\\\": false,\\n        \\\"<S-Tab>\\\": false\\n    },\\n    \\\"vim.insertModeKeyBindings\\\": [],\\n    \\\"vim.normalModeKeyBindings\\\": [],\\n    \\\"vim.visualModeKeyBindings\\\": [],\\n    \\\"vim.normalModeKeyBindingsNonRecursive\\\": [\\n        // --- 核心移动键重映射 (n/e/u/i -> h/j/k/l) ---\\n        {\\n            \\\"before\\\": [\\n                \\\"n\\\"\\n            ],\\n            \\\"after\\\": [\\n                \\\"h\\\"\\n            ]\\n        },\\n        {\\n            \\\"before\\\": [\\n                \\\"e\\\"\\n            ],\\n            \\\"after\\\": [\\n                \\\"j\\\"\\n            ]\\n        },\\n        {\\n            \\\"before\\\": [\\n                \\\"u\\\"\\n            ],\\n            \\\"after\\\": [\\n                \\\"k\\\"\\n            ]\\n        },\\n        {\\n            \\\"before\\\": [\\n                \\\"i\\\"\\n            ],\\n            \\\"after\\\": [\\n                \\\"l\\\"\\n            ]\\n        },\\n        // --- 被占用的原键位重新分配 ---\\n        // 原 h -> e (end of word)\\n        {\\n            \\\"before\\\": [\\n                \\\"h\\\"\\n            ],\\n            \\\"after\\\": [\\n                \\\"e\\\"\\n            ]\\n        },\\n        // 原 l -> u (undo)\\n        {\\n            \\\"before\\\": [\\n                \\\"l\\\"\\n            ],\\n            \\\"after\\\": [\\n                \\\"u\\\"\\n            ]\\n        },\\n        // 原 k -> i (insert mode)\\n        {\\n            \\\"before\\\": [\\n                \\\"k\\\"\\n            ],\\n            \\\"after\\\": [\\n                \\\"i\\\"\\n            ]\\n        },\\n        // 原 K -> I (insert at beginning of line)\\n        {\\n            \\\"before\\\": [\\n                \\\"K\\\"\\n            ],\\n            \\\"after\\\": [\\n                \\\"I\\\"\\n            ]\\n        },\\n        // 原 m -> n (next search result)\\n        {\\n            \\\"before\\\": [\\n                \\\"m\\\"\\n            ],\\n            \\\"after\\\": [\\n                \\\"n\\\"\\n            ]\\n        },\\n        // 原 M -> N (prev search result)\\n        {\\n            \\\"before\\\": [\\n                \\\"M\\\"\\n            ],\\n            \\\"after\\\": [\\n                \\\"N\\\"\\n            ]\\n        },\\n        // --- 你的 config/keymaps.lua 中的其他映射 ---\\n        {\\n            \\\"before\\\": [\\n                \\\";\\\"\\n            ],\\n            \\\"after\\\": [\\n                \\\":\\\"\\n            ]\\n        },\\n        {\\n            \\\"before\\\": [\\n                \\\"Y\\\"\\n            ],\\n            \\\"after\\\": [\\n                \\\"\\\\\\\"\\\",\\n                \\\"+\\\",\\n                \\\"y\\\"\\n            ]\\n        },\\n        {\\n            \\\"before\\\": [\\n                \\\"'\\\"\\n            ],\\n            \\\"after\\\": [\\n                \\\"m\\\"\\n            ]\\n        }, // ' 映射为 mark\\n        // --- 快速跳转 ---\\n        {\\n            \\\"before\\\": [\\n                \\\"U\\\"\\n            ],\\n            \\\"after\\\": [\\n                \\\"5\\\",\\n                \\\"k\\\"\\n            ]\\n        },\\n        {\\n            \\\"before\\\": [\\n                \\\"E\\\"\\n            ],\\n            \\\"after\\\": [\\n                \\\"5\\\",\\n                \\\"j\\\"\\n            ]\\n        },\\n        {\\n            \\\"before\\\": [\\n                \\\"N\\\"\\n            ],\\n            \\\"after\\\": [\\n                \\\"0\\\"\\n            ]\\n        },\\n        {\\n            \\\"before\\\": [\\n                \\\"I\\\"\\n            ],\\n            \\\"after\\\": [\\n                \\\"$\\\"\\n            ]\\n        },\\n        // --- 保存和退出 ---\\n        {\\n            \\\"before\\\": [\\n                \\\"<S-s>\\\"\\n            ],\\n            \\\"commands\\\": [\\n                \\\":w\\\"\\n            ]\\n        },\\n        {\\n            \\\"before\\\": [\\n                \\\"<S-q>\\\"\\n            ],\\n            \\\"commands\\\": [\\n                \\\":q\\\"\\n            ]\\n        },\\n        // --- 窗口切换 (Leader + n/e/u/i) ---\\n        {\\n            \\\"before\\\": [\\n                \\\"<leader>\\\",\\n                \\\"n\\\"\\n            ],\\n            \\\"commands\\\": [\\n                \\\"workbench.action.navigateLeft\\\"\\n            ]\\n        },\\n        {\\n            \\\"before\\\": [\\n                \\\"<leader>\\\",\\n                \\\"e\\\"\\n            ],\\n            \\\"commands\\\": [\\n                \\\"workbench.action.navigateDown\\\"\\n            ]\\n        },\\n        {\\n            \\\"before\\\": [\\n                \\\"<leader>\\\",\\n                \\\"u\\\"\\n            ],\\n            \\\"commands\\\": [\\n                \\\"workbench.action.navigateUp\\\"\\n            ]\\n        },\\n        {\\n            \\\"before\\\": [\\n                \\\"<leader>\\\",\\n                \\\"i\\\"\\n            ],\\n            \\\"commands\\\": [\\n                \\\"workbench.action.navigateRight\\\"\\n            ]\\n        },\\n        // --- Buffer/标签页切换 ---\\n        {\\n            \\\"before\\\": [\\n                \\\"<leader>\\\",\\n                \\\" \\\"\\n            ],\\n            \\\"commands\\\": [\\n                \\\"workbench.action.nextEditor\\\"\\n            ]\\n        },\\n        {\\n            \\\"before\\\": [\\n                \\\"<leader>\\\",\\n                \\\"<BS>\\\"\\n            ],\\n            \\\"commands\\\": [\\n                \\\"workbench.action.previousEditor\\\"\\n            ]\\n        },\\n        {\\n            \\\"before\\\": [\\n                \\\"<C-w>\\\"\\n            ],\\n            \\\"commands\\\": [\\n                \\\"workbench.action.closeActiveEditor\\\"\\n            ]\\n        },\\n        // --- 取消高亮 ---\\n        {\\n            \\\"before\\\": [\\n                \\\"q\\\",\\n                \\\"q\\\"\\n            ],\\n            \\\"commands\\\": [\\n                \\\":nohl\\\"\\n            ]\\n        },\\n        {\\n            \\\"before\\\": [\\n                \\\"t\\\",\\n                \\\"t\\\"\\n            ],\\n            \\\"commands\\\": [\\n                \\\"workbench.action.toggleSidebarVisibility\\\",\\n                // 如果你希望打开的同时聚焦到文件树，可以使用:\\n                // \\\"workbench.view.explorer\\\"\\n            ]\\n        },\\n        {\\n            \\\"before\\\": [\\n                \\\"<leader>\\\",\\n                \\\"1\\\"\\n            ],\\n            \\\"commands\\\": [\\n                \\\"workbench.action.openEditorAtIndex1\\\"\\n            ]\\n        },\\n        {\\n            \\\"before\\\": [\\n                \\\"<leader>\\\",\\n                \\\"2\\\"\\n            ],\\n            \\\"commands\\\": [\\n                \\\"workbench.action.openEditorAtIndex2\\\"\\n            ]\\n        },\\n        {\\n            \\\"before\\\": [\\n                \\\"<leader>\\\",\\n                \\\"3\\\"\\n            ],\\n            \\\"commands\\\": [\\n                \\\"workbench.action.openEditorAtIndex3\\\"\\n            ]\\n        },\\n        {\\n            \\\"before\\\": [\\n                \\\"<leader>\\\",\\n                \\\"4\\\"\\n            ],\\n            \\\"commands\\\": [\\n                \\\"workbench.action.openEditorAtIndex4\\\"\\n            ]\\n        },\\n        {\\n            \\\"before\\\": [\\n                \\\"<leader>\\\",\\n                \\\"5\\\"\\n            ],\\n            \\\"commands\\\": [\\n                \\\"workbench.action.openEditorAtIndex5\\\"\\n            ]\\n        },\\n        {\\n            \\\"before\\\": [\\n                \\\"<leader>\\\",\\n                \\\"6\\\"\\n            ],\\n            \\\"commands\\\": [\\n                \\\"workbench.action.openEditorAtIndex6\\\"\\n            ]\\n        },\\n        {\\n            \\\"before\\\": [\\n                \\\"<leader>\\\",\\n                \\\"7\\\"\\n            ],\\n            \\\"commands\\\": [\\n                \\\"workbench.action.openEditorAtIndex7\\\"\\n            ]\\n        },\\n        {\\n            \\\"before\\\": [\\n                \\\"<leader>\\\",\\n                \\\"8\\\"\\n            ],\\n            \\\"commands\\\": [\\n                \\\"workbench.action.openEditorAtIndex8\\\"\\n            ]\\n        },\\n        {\\n            \\\"before\\\": [\\n                \\\"g\\\",\\n                \\\"d\\\"\\n            ],\\n            \\\"commands\\\": [\\n                \\\"editor.action.revealDefinition\\\"\\n            ]\\n        },\\n        {\\n            \\\"before\\\": [\\n                \\\"g\\\",\\n                \\\"r\\\"\\n            ], // 或者你习惯的键位\\n            \\\"commands\\\": [\\n                \\\"editor.action.peekDefinition\\\"\\n            ]\\n        }\\n    ],\\n    \\\"vim.visualModeKeyBindingsNonRecursive\\\": [\\n        // Visual 模式下的移动\\n        {\\n            \\\"before\\\": [\\n                \\\"n\\\"\\n            ],\\n            \\\"after\\\": [\\n                \\\"h\\\"\\n            ]\\n        },\\n        {\\n            \\\"before\\\": [\\n                \\\"e\\\"\\n            ],\\n            \\\"after\\\": [\\n                \\\"j\\\"\\n            ]\\n        },\\n        {\\n            \\\"before\\\": [\\n                \\\"u\\\"\\n            ],\\n            \\\"after\\\": [\\n                \\\"k\\\"\\n            ]\\n        },\\n        {\\n            \\\"before\\\": [\\n                \\\"i\\\"\\n            ],\\n            \\\"after\\\": [\\n                \\\"l\\\"\\n            ]\\n        },\\n        {\\n            \\\"before\\\": [\\n                \\\"h\\\"\\n            ],\\n            \\\"after\\\": [\\n                \\\"e\\\"\\n            ]\\n        },\\n        {\\n            \\\"before\\\": [\\n                \\\"l\\\"\\n            ],\\n            \\\"after\\\": [\\n                \\\"u\\\"\\n            ]\\n        },\\n        {\\n            \\\"before\\\": [\\n                \\\"k\\\"\\n            ],\\n            \\\"after\\\": [\\n                \\\"i\\\"\\n            ]\\n        },\\n        // 让你选中文本时也能快速移动\\n        {\\n            \\\"before\\\": [\\n                \\\"U\\\"\\n            ],\\n            \\\"after\\\": [\\n                \\\"5\\\",\\n                \\\"k\\\"\\n            ]\\n        },\\n        {\\n            \\\"before\\\": [\\n                \\\"E\\\"\\n            ],\\n            \\\"after\\\": [\\n                \\\"5\\\",\\n                \\\"j\\\"\\n            ]\\n        },\\n        {\\n            \\\"before\\\": [\\n                \\\"N\\\"\\n            ],\\n            \\\"after\\\": [\\n                \\\"0\\\"\\n            ]\\n        },\\n        {\\n            \\\"before\\\": [\\n                \\\"I\\\"\\n            ],\\n            \\\"after\\\": [\\n                \\\"$\\\"\\n            ]\\n        }\\n    ],\\n    \\\"vim.operatorPendingModeKeyBindingsNonRecursive\\\": [\\n        // 关键修复：让 ckw, diw, yiw 等操作生效\\n        {\\n            \\\"before\\\": [\\n                \\\"k\\\"\\n            ],\\n            \\\"after\\\": [\\n                \\\"i\\\"\\n            ]\\n        },\\n        // 也可以让他在 operator 模式下使用你的方向键\\n        {\\n            \\\"before\\\": [\\n                \\\"n\\\"\\n            ],\\n            \\\"after\\\": [\\n                \\\"h\\\"\\n            ]\\n        },\\n        {\\n            \\\"before\\\": [\\n                \\\"e\\\"\\n            ],\\n            \\\"after\\\": [\\n                \\\"j\\\"\\n            ]\\n        },\\n        {\\n            \\\"before\\\": [\\n                \\\"u\\\"\\n            ],\\n            \\\"after\\\": [\\n                \\\"k\\\"\\n            ]\\n        },\\n        {\\n            \\\"before\\\": [\\n                \\\"i\\\"\\n            ],\\n            \\\"after\\\": [\\n                \\\"l\\\"\\n            ]\\n        },\\n        // 还有 H -> E (END OF WORD) 也很常用，比如 DHE (删除到单词末尾)\\n        {\\n            \\\"before\\\": [\\n                \\\"h\\\"\\n            ],\\n            \\\"after\\\": [\\n                \\\"e\\\"\\n            ]\\n        },\\n    ],\\n    \\\"workbench.colorTheme\\\": \\\"Tokyo Night Light\\\",\\n}\"}","keybindings":"{\"keybindings\":\"[\\n  {\\n    \\\"key\\\": \\\"tab\\\",\\n    \\\"command\\\": \\\"selectNextSuggestion\\\",\\n    \\\"when\\\": \\\"suggestWidgetMultipleSuggestions && suggestWidgetVisible && textInputFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+n\\\",\\n    \\\"command\\\": \\\"-selectNextSuggestion\\\",\\n    \\\"when\\\": \\\"suggestWidgetMultipleSuggestions && suggestWidgetVisible && textInputFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+tab\\\",\\n    \\\"command\\\": \\\"selectPrevSuggestion\\\",\\n    \\\"when\\\": \\\"suggestWidgetMultipleSuggestions && suggestWidgetVisible && textInputFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+p\\\",\\n    \\\"command\\\": \\\"-selectPrevSuggestion\\\",\\n    \\\"when\\\": \\\"suggestWidgetMultipleSuggestions && suggestWidgetVisible && textInputFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+h\\\",\\n    \\\"command\\\": \\\"editor.action.startFindReplaceAction\\\",\\n    \\\"when\\\": \\\"editorFocus || editorIsOpen\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"n\\\",\\n    \\\"command\\\": \\\"list.collapse\\\",\\n    \\\"when\\\": \\\"listFocus && !inputFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"h\\\",\\n    \\\"command\\\": \\\"-list.collapse\\\",\\n    \\\"when\\\": \\\"listFocus && !inputFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"i\\\",\\n    \\\"command\\\": \\\"list.select\\\",\\n    \\\"when\\\": \\\"listFocus && !inputFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"l\\\",\\n    \\\"command\\\": \\\"-list.select\\\",\\n    \\\"when\\\": \\\"listFocus && !inputFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"e\\\",\\n    \\\"command\\\": \\\"list.focusDown\\\",\\n    \\\"when\\\": \\\"listFocus && !inputFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"j\\\",\\n    \\\"command\\\": \\\"-list.focusDown\\\",\\n    \\\"when\\\": \\\"listFocus && !inputFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"u\\\",\\n    \\\"command\\\": \\\"list.focusUp\\\",\\n    \\\"when\\\": \\\"listFocus && !inputFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"k\\\",\\n    \\\"command\\\": \\\"-list.focusUp\\\",\\n    \\\"when\\\": \\\"listFocus && !inputFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+t\\\",\\n    \\\"command\\\": \\\"workbench.action.terminal.toggleTerminal\\\",\\n    \\\"when\\\": \\\"terminal.active\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+g\\\",\\n    \\\"command\\\": \\\"workbench.action.findInFiles\\\",\\n    \\\"when\\\": \\\"!searchViewletVisible\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+g\\\",\\n    \\\"command\\\": \\\"runCommands\\\",\\n    \\\"when\\\": \\\"searchViewletVisible\\\",\\n    \\\"args\\\": {\\n      \\\"commands\\\": [\\n        \\\"workbench.view.explorer\\\", // 1. 先切回文件树\\n        \\\"workbench.action.closeSidebar\\\" // 2. 再关闭侧边栏\\n      ]\\n    }\\n  },\\n  // 注意：这将覆盖默认的“转到行...”\\n  {\\n    \\\"key\\\": \\\"ctrl+f\\\",\\n    \\\"command\\\": \\\"workbench.action.quickOpen\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"tab\\\",\\n    \\\"command\\\": \\\"workbench.action.quickOpenSelectNext\\\",\\n    \\\"when\\\": \\\"inQuickOpen\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+tab\\\",\\n    \\\"command\\\": \\\"workbench.action.quickOpenSelectPrevious\\\",\\n    \\\"when\\\": \\\"inQuickOpen\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"a\\\",\\n    \\\"command\\\": \\\"explorer.newFile\\\",\\n    \\\"when\\\": \\\"filesExplorerFocus && !inputFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"shift+a\\\",\\n    \\\"command\\\": \\\"explorer.newFolder\\\",\\n    \\\"when\\\": \\\"filesExplorerFocus && !inputFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"r\\\",\\n    \\\"command\\\": \\\"renameFile\\\",\\n    \\\"when\\\": \\\"filesExplorerFocus && !inputFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"o\\\",\\n    \\\"command\\\": \\\"list.select\\\",\\n    \\\"when\\\": \\\"filesExplorerFocus && !inputFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"d\\\",\\n    \\\"command\\\": \\\"deleteFile\\\",\\n    \\\"when\\\": \\\"filesExplorerFocus && !inputFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"y\\\",\\n    \\\"command\\\": \\\"filesExplorer.copy\\\",\\n    \\\"when\\\": \\\"filesExplorerFocus && !inputFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"x\\\",\\n    \\\"command\\\": \\\"filesExplorer.cut\\\",\\n    \\\"when\\\": \\\"filesExplorerFocus && !inputFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"p\\\",\\n    \\\"command\\\": \\\"filesExplorer.paste\\\",\\n    \\\"when\\\": \\\"filesExplorerFocus && !inputFocus\\\"\\n  },\\n  {\\n    \\\"key\\\": \\\"ctrl+/\\\",\\n    \\\"command\\\": \\\"editor.action.commentLine\\\",\\n    \\\"when\\\": \\\"editorTextFocus && !editorReadonly\\\"\\n  },\\n  // 即使没有缩进的情况也要取消\\n  {\\n    \\\"key\\\": \\\"tab\\\",\\n    \\\"command\\\": \\\"-edit